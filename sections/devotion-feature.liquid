{% comment %} Devotion feature — dedicated section for the bag-back devotion panel {% endcomment %}
<section id="devotion" class="band devotion-feature">
  <div class="wrap devotion-feature-grid">
    <div class="devotion-feature-copy">
      <span class="rule">The back of the bag</span>
      <h2>{{ section.settings.heading | default: 'A new devotion, printed once, gone with the month.' }}</h2>
      <p class="lede mt-4">{{ section.settings.description | default: 'Every month we write and print one devotion and prayer on the back of the bag. When the month ends, that bag ends. The next one comes with something new to sit with.' }}</p>
      <a href="{{ section.settings.cta_url | default: '#coffee' }}" class="btn btn-gold mt-6">{{ section.settings.cta_text | default: 'Start a morning' }}</a>
    </div>
    <div>
      {% render 'devotion-panel',
        number: section.settings.devotion_number | default: 'No. 01',
        month: section.settings.devotion_month | default: 'August',
        title: section.settings.devotion_title | default: 'Morning Mercies',
        author: section.settings.devotion_author | default: 'Written by Alex Lambert',
        verse: section.settings.devotion_verse | default: 'Because of the Lord\'s great love we are not consumed, for his compassions never fail. They are new every morning.',
        citation: section.settings.devotion_citation | default: 'Lamentations 3 : 22–23',
        body: section.settings.devotion_body | default: 'Jeremiah wrote that looking at a burned city. Not from a good week. Not with anything resolved.\n\nWhatever yesterday cost you, it did not carry over. The mercy waiting this morning is not the remainder of yesterday\'s. It is new, it is enough for today, and there is no version of you too far behind to receive it.' | newline_to_br | split: '<br />',
        prayer: section.settings.devotion_prayer | default: 'Father, I have carried yesterday into this kitchen with me. Take it. Let me start here, with what is new, and let me be slow to pick it back up.',
        brand: settings.brand_name,
        bagline: section.settings.devotion_bagline | default: '12 oz · Whole bean'
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Devotion feature",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A new devotion, printed once, gone with the month." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Every month we write and print one devotion and prayer on the back of the bag. When the month ends, that bag ends. The next one comes with something new to sit with." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Start a morning" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "header", "content": "Devotion panel" },
    { "type": "text", "id": "devotion_number", "label": "Issue number", "default": "No. 01" },
    { "type": "text", "id": "devotion_month", "label": "Month", "default": "August" },
    { "type": "text", "id": "devotion_title", "label": "Title", "default": "Morning Mercies" },
    { "type": "text", "id": "devotion_author", "label": "Author", "default": "Written by Alex Lambert" },
    { "type": "textarea", "id": "devotion_verse", "label": "Verse", "default": "Because of the Lord's great love we are not consumed, for his compassions never fail. They are new every morning." },
    { "type": "text", "id": "devotion_citation", "label": "Citation", "default": "Lamentations 3 : 22–23" },
    { "type": "textarea", "id": "devotion_body", "label": "Body" },
    { "type": "textarea", "id": "devotion_prayer", "label": "Prayer" },
    { "type": "text", "id": "devotion_bagline", "label": "Bagline", "default": "12 oz · Whole bean" }
  ],
  "presets": [ { "name": "Devotion feature" } ]
}
{% endschema %}
