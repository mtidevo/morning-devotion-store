{% comment %} Main cart template section {% endcomment %}
<section class="cart-section">
  <div class="wrap">
    <span class="rule">Your cart</span>
    <h1 class="mb-6">Cart</h1>

    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        {% render 'icon-shopping-bag' %}
        <p class="text-mute">Your cart is empty</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-gold mt-4">Continue shopping</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-form">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              {% if item.image != blank %}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="100">
              {% else %}
                <div style="background: var(--sagetint); aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; color: var(--sage-d);">
                  {% render 'icon-shopping-bag' %}
                </div>
              {% endif %}

              <div>
                <div class="cart-item-title">{{ item.product.title }}</div>
                <div class="cart-item-variant">{{ item.variant.title }}</div>
                <div class="cart-item-qty">
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
                </div>
              </div>

              <div class="cart-item-price">{{ item.line_price | money }}</div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-footer">
          <div>
            <button type="submit" name="update" class="btn btn-edge btn-sm">Update cart</button>
          </div>
          <div class="text-right">
            <div class="cart-total-label">Subtotal</div>
            <div class="cart-total-amount">{{ cart.total_price | money }}</div>
            <button type="submit" name="checkout" class="btn btn-gold mt-4">Checkout</button>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
