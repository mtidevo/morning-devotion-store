{% comment %} Product template — two-column with sticky info, low-stock bar {% endcomment %}<style>.pdp { background:#f6efe2; } .pdp-main-image { background:#fff; border:1px solid rgba(35,29,21,.08); border-radius:24px; overflow:hidden; } .pdp-thumb { background:#fff; border-radius:12px; } @media (min-width: 901px) { .pdp-media { position:sticky; top:110px; align-self:start; } } .apps-section { background:#f6efe2; } #judgeme_product_reviews { --jdgm-primary-color:#a8843f; --jdgm-secondary-color:rgba(168,132,63,.12); --jdgm-star-color:#a8843f; --jdgm-paginate-color:#a8843f; --jdgm-btn-bg:#a8843f; } #judgeme_product_reviews .jdgm-write-rev-link, #judgeme_product_reviews button { background:#a8843f !important; border-color:#a8843f !important; color:#fff !important; border-radius:999px !important; }</style>{%- assign fem_rc = product.metafields.reviews.rating_count.value | default: 0 -%}{%- if fem_rc == 0 -%}<style>.apps-section { display:none; }</style>{%- endif -%}
{%- assign is_color_option = false -%}
{%- for opt in product.options_with_values -%}
  {%- assign lower = opt.name | downcase -%}
  {%- if lower contains 'color' or lower contains 'colour' -%}
    {%- assign is_color_option = true -%}
    {%- assign color_option_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

<section class="pdp">
  <div class="wrap pdp-grid">
    {%- assign main_alt = product.featured_image.alt -%}
    {%- if main_alt == blank or main_alt == 'Product Image' -%}{%- assign main_alt = product.title | append: ' coffee, 12 oz carton' -%}{%- endif -%}
    <div class="pdp-media">
      {% if product.featured_image != blank %}
        <div class="pdp-main-image">
          <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ main_alt | escape }}" width="1200" height="{{ 1200 | divided_by: product.featured_image.aspect_ratio | round }}" loading="eager" fetchpriority="high" data-pdp-main-img>
        </div>
      {% endif %}
      {% if product.images.size > 1 %}
        <div class="pdp-thumbs">
          {% for img in product.images %}
            {%- assign thumb_alt = img.alt -%}
            {%- if thumb_alt == blank or thumb_alt == 'Product Image' -%}{%- assign thumb_alt = product.title | append: ' coffee carton, view ' | append: forloop.index -%}{%- endif -%}
            <button type="button" class="pdp-thumb{% if forloop.first %} is-active{% endif %}" data-pdp-thumb="{{ img | image_url: width: 1200 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ img | image_url: width: 200 }}" alt="{{ thumb_alt | escape }}" width="100" height="{{ 100 | divided_by: img.aspect_ratio | round }}" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="pdp-info">
      <div class="pdp-info-inner">
        {% if product.type != blank %}<span class="rule">{{ product.type }}</span>{% endif %}
        <h1 class="pdp-title">{{ product.title }}</h1>
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="pdp-app-block">{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}

        <div class="pdp-price-row">
          <span class="pdp-price" data-pdp-price>{{ product.selected_or_first_available_variant.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="pdp-compare">{{ product.compare_at_price | money }}</span>
          {% endif %}
          {%- assign rating = product.metafields.reviews.rating.value.rating | round: 1 -%}
          {% if rating and rating != blank and rating > 0 %}
            <span class="pdp-rating" aria-label="Rated {{ rating }} out of 5">
              {% render 'icon-star' %} {{ rating }}
              {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
              {% if rating_count %}<span class="pdp-rating-count">({{ rating_count }})</span>{% endif %}
            </span>
          {% endif %}
          {% if product.selected_or_first_available_variant.available %}
            <span class="pdp-stock-pill" data-pdp-stock>In stock</span>
          {% else %}
            <span class="pdp-stock-pill pdp-stock-pill--out" data-pdp-stock>Sold out</span>
          {% endif %}
        </div>

        {%- assign countdown_target = section.settings.countdown_target | default: product.metafields.custom.countdown_target -%}
        {% if countdown_target != blank %}
          <div class="pdp-countdown" data-countdown-target="{{ countdown_target }}">
            <span class="pdp-countdown-label">{{ section.settings.countdown_label | default: 'Hurry up!' }}</span>
            <span class="pdp-countdown-unit"><b data-countdown-days>0</b>d</span>
            <span class="pdp-countdown-unit"><b data-countdown-hours>00</b>h</span>
            <span class="pdp-countdown-unit"><b data-countdown-mins>00</b>m</span>
            <span class="pdp-countdown-unit"><b data-countdown-secs>00</b>s</span>
          </div>
        {% endif %}

        {% assign inv = product.selected_or_first_available_variant.inventory_quantity | default: 0 %}
        {% if product.selected_or_first_available_variant.inventory_management == 'shopify' and inv > 0 and inv <= 20 %}
          {% assign pct = inv | times: 5 %}
          <div class="pdp-stock-bar" role="progressbar" aria-valuemin="0" aria-valuemax="20" aria-valuenow="{{ inv }}">
            <div class="pdp-stock-bar-fill" style="width: {{ pct }}%;"></div>
          </div>
          <p class="pdp-stock-note">Only {{ inv }} left this month</p>
        {% endif %}

        {% if product.type == 'Coffee' %}<p class="pdp-ship-note" style="margin:10px 0 0;font-size:14px;color:var(--mute);">{% render 'icon-truck' %} <strong style="color:var(--ink);font-weight:500;">$4.50 shipping</strong> on 1 bag &middot; <strong style="color:var(--ink);font-weight:500;">free</strong> on 2 or more. Mix any coffees.</p>{% endif %}<div class="pdp-desc">{{ product.description }}</div>

        {% form 'product', product, class: 'pdp-form', data-pdp-form: '' %}
          {% render 'variant-json', product: product %}
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {%- assign opt_lower = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- if opt_lower contains 'color' or opt_lower contains 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
              <div class="pdp-option{% if is_color %} pdp-option--color{% endif %}">
                <span class="pdp-option-label">
                  {{ option.name }}{% if is_color %}: <b data-pdp-color-value>{{ option.selected_value }}</b>{% endif %}
                </span>
                <div class="pdp-swatches{% if is_color %} pdp-swatches--image{% endif %}">
                  {% for value in option.values %}
                    {%- assign swatch_img = '' -%}
                    {%- if is_color -%}
                      {%- for v in product.variants -%}
                        {%- assign vopt = v.options[forloop.parentloop.index0] -%}
                        {%- if vopt == value and v.image != blank and swatch_img == '' -%}
                          {%- assign swatch_img = v.image | image_url: width: 120 -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    <label class="pdp-swatch{% if is_color %} pdp-swatch--image{% endif %}{% if option.selected_value == value %} is-active{% endif %}"
                           {% if is_color and swatch_img != '' %}style="background-image:url('{{ swatch_img }}');"{% endif %}
                           title="{{ value | escape }}">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-pdp-option data-option-index="{{ forloop.parentloop.index0 }}">
                      {% unless is_color %}<span>{{ value }}</span>{% endunless %}
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-pdp-variant-id>
          {%- assign gb_tag = settings.gb_picker_tag | default: 'gift-basket' -%}{%- if product.tags contains gb_tag -%}{% render 'basket-blend-picker', product: product %}{%- endif -%}

          <div class="pdp-qty-row">
            <div class="pdp-qty">
              <button type="button" aria-label="Decrease" data-pdp-qty-minus>−</button>
              <input type="number" name="quantity" value="1" min="1" data-pdp-qty>
              <button type="button" aria-label="Increase" data-pdp-qty-plus>+</button>
            </div>
            <button type="submit" class="btn btn-gold pdp-add" data-pdp-add {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              <span data-pdp-add-label>{% if product.selected_or_first_available_variant.available %}Add to cart · <span data-pdp-total>{{ product.selected_or_first_available_variant.price | money }}</span>{% else %}Sold out{% endif %}</span>
            </button>
          </div>
          <div class="pdp-dynamic-checkout">{{ form | payment_button }}</div>
        {% endform %}

        {%- assign upgrade_count = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'upgrade' and block.settings.product != blank -%}{%- assign upgrade_count = upgrade_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {% if upgrade_count > 0 %}
          <div class="pdp-upgrades" data-pdp-upgrades>
            <div class="pdp-upgrades-head">
              <span>{{ section.settings.upgrades_title | default: 'Popular upgrades' }}</span>
              <button type="button" class="pdp-upgrades-close" aria-label="Dismiss" data-pdp-upgrades-close>{% render 'icon-x' %}</button>
            </div>
            <div class="pdp-upgrades-list">
              {% for block in section.blocks %}
                {% if block.type == 'upgrade' and block.settings.product != blank %}
                  {% render 'upgrade-row', product: block.settings.product %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {%- assign is_gear = false -%}
        {%- if product.tags contains 'accessories' or product.type == 'Brewing Gear' -%}{%- assign is_gear = true -%}{%- endif -%}
        {%- assign is_basket = false -%}{%- assign gb_tag = settings.gb_picker_tag | default: 'gift-basket' -%}{%- if product.tags contains gb_tag -%}{%- assign is_basket = true -%}{%- endif -%}
        <ul class="pdp-perks">
          {% if is_gear %}
            <li>{% render 'icon-truck' %} Ships separately from our brewing partners</li>
            <li>{% render 'icon-coffee' %} Pairs with any For Every Morning coffee</li>
          {% else %}
            {%- if is_basket -%}<li>{% render 'icon-truck' %} {{ settings.gb_perk_shipping }}</li>{%- else -%}            <li>{% render 'icon-truck' %} Free shipping on 2+ bags ($4.50 for one)</li>{%- endif -%}
            {% if product.selling_plan_groups.size > 0 %}<li>{% render 'icon-refresh' %} Skip or cancel any month</li>{% endif %}
            {%- if is_basket -%}<li>{% render 'icon-book' %} {{ settings.gb_perk_devotion }}</li>{%- else -%}            <li>{% render 'icon-book' %} A new devotion on the back</li>{%- endif -%}
            <li>{% render 'icon-sparkles' %} {{ section.settings.guarantee_text | default: 'Love your first bag, or we make it right' }}</li>
          {% endif %}
        </ul>

        {% if section.settings.show_tabs and is_gear == false %}
          <div class="pdp-tabs" data-pdp-tabs>
            <div class="pdp-tabs-nav" role="tablist">
              <button type="button" role="tab" aria-selected="true" data-pdp-tab="details">Details</button>
              <button type="button" role="tab" aria-selected="false" data-pdp-tab="brewing">Brewing</button>
              <button type="button" role="tab" aria-selected="false" data-pdp-tab="shipping">Shipping</button>
            </div>
            <div class="pdp-tabs-panels">
              <div data-pdp-panel="details" class="is-active">
                <p>{%- if is_basket -%}{{ settings.gb_details_text }}{%- else -%}{{ section.settings.details_text | default: 'Specialty grade, small-batch roasted in Bend, Oregon. 12 oz bag, whole bean or ground.' }}{%- endif -%}</p>
              </div>
              <div data-pdp-panel="brewing" hidden>
                <p>{{ section.settings.brewing_text | default: 'Pour-over: 1:16 ratio. French press: 1:15, 4 min steep. Espresso: 18 g in, 36 g out, 28 s.' }}</p>
              </div>
              <div data-pdp-panel="shipping" hidden>
                <p>{%- if is_basket -%}{{ settings.gb_shipping_text }}{%- else -%}{{ section.settings.shipping_text | default: 'Ships within 2 business days of roast. Free US shipping on 2 or more bags.' }}{%- endif -%}</p>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  /* Keep the Subscribe & save / One-time choice when the customer switches grind.
     The subscriptions app renders one set of options per variant, and the new variant's set starts on one-time. */
  (function () {
    var app = document.querySelector('.pdp-app-block');
    if (!app) return;
    var lastType = null, lastPlan = null;
    function visibleFieldset() {
      var sets = app.querySelectorAll('.shopify_subscriptions_fieldset');
      for (var i = 0; i < sets.length; i++) { if (sets[i].offsetParent !== null) return sets[i]; }
      return null;
    }
    function remember() {
      var fs = visibleFieldset(); if (!fs) return;
      var r = fs.querySelector('input[type=radio]:checked'); if (!r) return;
      lastType = r.getAttribute('data-radio-type');
      lastPlan = r.getAttribute('data-selling-plan-id');
    }
    function restore() {
      if (!lastType) return;
      var fs = visibleFieldset(); if (!fs) return;
      var target = null;
      if (lastType === 'selling_plan') {
        target = (lastPlan && fs.querySelector('input[type=radio][data-selling-plan-id="' + lastPlan + '"]')) || fs.querySelector('input[type=radio][data-radio-type=selling_plan]');
      } else {
        target = fs.querySelector('input[type=radio][data-radio-type=one_time_purchase]');
      }
      if (target && !target.checked) { target.click(); }
    }
    app.addEventListener('change', function (e) { if (e.target && e.target.type === 'radio') remember(); });
    remember();
    document.querySelectorAll('[data-pdp-option]').forEach(function (opt) {
      opt.addEventListener('change', function () {
        [60, 250, 600].forEach(function (ms) { setTimeout(restore, ms); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show product tabs",
      "default": true
    },
    {
      "type": "textarea",
      "id": "details_text",
      "label": "Details tab"
    },
    {
      "type": "textarea",
      "id": "brewing_text",
      "label": "Brewing tab"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping tab"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text (not shown)"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Hurry up!"
    },
    {
      "type": "text",
      "id": "countdown_target",
      "label": "Countdown target (ISO 8601, e.g. 2026-12-31T23:59:00)"
    },
    {
      "type": "header",
      "content": "Popular upgrades"
    },
    {
      "type": "text",
      "id": "upgrades_title",
      "label": "Upgrades title",
      "default": "Popular upgrades"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee line",
      "default": "Love your first bag, or we make it right"
    }
  ],
  "blocks": [
    {
      "type": "upgrade",
      "name": "Upgrade",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Upgrade product"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
