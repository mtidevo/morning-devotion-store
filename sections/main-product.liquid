{% comment %} Product template — two-column with sticky info, rotating badge, low-stock bar {% endcomment %}
{%- assign is_color_option = false -%}
{%- for opt in product.options_with_values -%}
  {%- assign lower = opt.name | downcase -%}
  {%- if lower contains 'color' or lower contains 'colour' -%}
    {%- assign is_color_option = true -%}
    {%- assign color_option_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

<section class="pdp">
  <div class="wrap pdp-grid">
    <div class="pdp-media">
      <div class="pdp-badge-wrap">
        {% render 'circle-text', text: section.settings.badge_text | default: 'New devotion · Roasted fresh', size: 130 %}
      </div>
      {% if product.featured_image != blank %}
        <div class="pdp-main-image">
          <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}" width="1200" loading="eager" data-pdp-main-img>
        </div>
      {% endif %}
      {% if product.images.size > 1 %}
        <div class="pdp-thumbs">
          {% for img in product.images %}
            <button type="button" class="pdp-thumb{% if forloop.first %} is-active{% endif %}" data-pdp-thumb="{{ img | image_url: width: 1200 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ img | image_url: width: 200 }}" alt="" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="pdp-info">
      <div class="pdp-info-inner">
        {% if product.type != blank %}<span class="rule">{{ product.type }}</span>{% endif %}
        <h1 class="pdp-title">{{ product.title }}</h1>

        <div class="pdp-price-row">
          <span class="pdp-price" data-pdp-price>{{ product.selected_or_first_available_variant.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="pdp-compare">{{ product.compare_at_price | money }}</span>
          {% endif %}
          {%- assign rating = product.metafields.reviews.rating.value -%}
          {% if rating and rating != blank %}
            <span class="pdp-rating" aria-label="Rated {{ rating }} out of 5">
              {% render 'icon-star' %} {{ rating }}
              {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
              {% if rating_count %}<span class="pdp-rating-count">({{ rating_count }})</span>{% endif %}
            </span>
          {% endif %}
          {% if product.selected_or_first_available_variant.available %}
            <span class="pdp-stock-pill">In stock</span>
          {% else %}
            <span class="pdp-stock-pill pdp-stock-pill--out">Sold out</span>
          {% endif %}
        </div>

        {%- assign countdown_target = section.settings.countdown_target | default: product.metafields.custom.countdown_target -%}
        {% if countdown_target != blank %}
          <div class="pdp-countdown" data-countdown-target="{{ countdown_target }}">
            <span class="pdp-countdown-label">{{ section.settings.countdown_label | default: 'Hurry up!' }}</span>
            <span class="pdp-countdown-unit"><b data-countdown-days>0</b>d</span>
            <span class="pdp-countdown-unit"><b data-countdown-hours>00</b>h</span>
            <span class="pdp-countdown-unit"><b data-countdown-mins>00</b>m</span>
            <span class="pdp-countdown-unit"><b data-countdown-secs>00</b>s</span>
          </div>
        {% endif %}

        {% assign inv = product.selected_or_first_available_variant.inventory_quantity | default: 0 %}
        {% if product.selected_or_first_available_variant.inventory_management == 'shopify' and inv > 0 and inv <= 20 %}
          {% assign pct = inv | times: 5 %}
          <div class="pdp-stock-bar" role="progressbar" aria-valuemin="0" aria-valuemax="20" aria-valuenow="{{ inv }}">
            <div class="pdp-stock-bar-fill" style="width: {{ pct }}%;"></div>
          </div>
          <p class="pdp-stock-note">Only {{ inv }} left this month</p>
        {% endif %}

        <div class="pdp-desc">{{ product.description }}</div>

        {% form 'product', product, class: 'pdp-form', data-pdp-form: '' %}
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {%- assign opt_lower = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- if opt_lower contains 'color' or opt_lower contains 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
              <div class="pdp-option{% if is_color %} pdp-option--color{% endif %}">
                <span class="pdp-option-label">
                  {{ option.name }}{% if is_color %}: <b data-pdp-color-value>{{ option.selected_value }}</b>{% endif %}
                </span>
                <div class="pdp-swatches{% if is_color %} pdp-swatches--image{% endif %}">
                  {% for value in option.values %}
                    {%- assign swatch_img = '' -%}
                    {%- if is_color -%}
                      {%- for v in product.variants -%}
                        {%- assign vopt = v.options[forloop.parentloop.index0] -%}
                        {%- if vopt == value and v.image != blank and swatch_img == '' -%}
                          {%- assign swatch_img = v.image | image_url: width: 120 -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    <label class="pdp-swatch{% if is_color %} pdp-swatch--image{% endif %}{% if option.selected_value == value %} is-active{% endif %}"
                           {% if is_color and swatch_img != '' %}style="background-image:url('{{ swatch_img }}');"{% endif %}
                           title="{{ value | escape }}">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-pdp-option>
                      {% unless is_color %}<span>{{ value }}</span>{% endunless %}
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-pdp-variant-id>

          <div class="pdp-qty-row">
            <div class="pdp-qty">
              <button type="button" aria-label="Decrease" data-pdp-qty-minus>−</button>
              <input type="number" name="quantity" value="1" min="1" data-pdp-qty>
              <button type="button" aria-label="Increase" data-pdp-qty-plus>+</button>
            </div>
            <button type="submit" class="btn btn-gold pdp-add" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              {% if product.selected_or_first_available_variant.available %}Add to cart · <span data-pdp-total>{{ product.selected_or_first_available_variant.price | money }}</span>{% else %}Sold out{% endif %}
            </button>
          </div>
        {% endform %}

        {%- assign upgrade_count = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'upgrade' and block.settings.product != blank -%}{%- assign upgrade_count = upgrade_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {% if upgrade_count > 0 %}
          <div class="pdp-upgrades" data-pdp-upgrades>
            <div class="pdp-upgrades-head">
              <span>🎁 {{ section.settings.upgrades_title | default: 'Popular upgrades' }}</span>
              <button type="button" class="pdp-upgrades-close" aria-label="Dismiss" data-pdp-upgrades-close>{% render 'icon-x' %}</button>
            </div>
            <div class="pdp-upgrades-list">
              {% for block in section.blocks %}
                {% if block.type == 'upgrade' and block.settings.product != blank %}
                  {% render 'upgrade-row', product: block.settings.product %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <ul class="pdp-perks">
          <li>{% render 'icon-truck' %} Free US shipping over $40</li>
          <li>{% render 'icon-refresh' %} Skip or cancel any month</li>
          <li>{% render 'icon-book' %} A new devotion on the back</li>
        </ul>

        {% if section.settings.show_tabs %}
          <div class="pdp-tabs" data-pdp-tabs>
            <div class="pdp-tabs-nav" role="tablist">
              <button type="button" role="tab" aria-selected="true" data-pdp-tab="details">Details</button>
              <button type="button" role="tab" aria-selected="false" data-pdp-tab="brewing">Brewing</button>
              <button type="button" role="tab" aria-selected="false" data-pdp-tab="shipping">Shipping</button>
            </div>
            <div class="pdp-tabs-panels">
              <div data-pdp-panel="details" class="is-active">
                <p>{{ section.settings.details_text | default: 'Specialty grade, small-batch roasted in Bend, Oregon. 12 oz whole bean.' }}</p>
              </div>
              <div data-pdp-panel="brewing" hidden>
                <p>{{ section.settings.brewing_text | default: 'Pour-over: 1:16 ratio. French press: 1:15, 4 min steep. Espresso: 18 g in, 36 g out, 28 s.' }}</p>
              </div>
              <div data-pdp-panel="shipping" hidden>
                <p>{{ section.settings.shipping_text | default: 'Ships within 2 business days of roast. Free on US orders over $40.' }}</p>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Rotating badge text", "default": "New devotion · Roasted fresh" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show product tabs", "default": true },
    { "type": "textarea", "id": "details_text", "label": "Details tab" },
    { "type": "textarea", "id": "brewing_text", "label": "Brewing tab" },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping tab" },
    { "type": "header", "content": "Countdown" },
    { "type": "text", "id": "countdown_label", "label": "Countdown label", "default": "Hurry up!" },
    { "type": "text", "id": "countdown_target", "label": "Countdown target (ISO 8601, e.g. 2026-12-31T23:59:00)" },
    { "type": "header", "content": "Popular upgrades" },
    { "type": "text", "id": "upgrades_title", "label": "Upgrades title", "default": "Popular upgrades" }
  ],
  "blocks": [
    {
      "type": "upgrade",
      "name": "Upgrade",
      "settings": [
        { "type": "product", "id": "product", "label": "Upgrade product" }
      ]
    }
  ]
}
{% endschema %}
