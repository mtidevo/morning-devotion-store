{% comment %} Before / after image slider {% endcomment %}
<section class="section ba-section">
  <div class="wrap">
    {% if section.settings.eyebrow != blank %}<span class="rule">{{ section.settings.eyebrow }}</span>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="ba-heading">{{ section.settings.heading }}</h2>{% endif %}

    <div class="ba" data-ba>
      {% if section.settings.image_after != blank %}
        <img class="ba-img ba-img--after" src="{{ section.settings.image_after | image_url: width: 1600 }}" alt="{{ section.settings.label_after | default: 'After' }}">
      {% endif %}
      <div class="ba-clip" data-ba-clip>
        {% if section.settings.image_before != blank %}
          <img class="ba-img ba-img--before" src="{{ section.settings.image_before | image_url: width: 1600 }}" alt="{{ section.settings.label_before | default: 'Before' }}">
        {% endif %}
      </div>
      <button type="button" class="ba-handle" data-ba-handle aria-label="Drag to compare">
        <span class="ba-handle-line"></span>
        <span class="ba-handle-knob">◀ ▶</span>
      </button>
      <span class="ba-label ba-label--before">{{ section.settings.label_before | default: 'Before' }}</span>
      <span class="ba-label ba-label--after">{{ section.settings.label_after | default: 'After' }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before / after",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "image_before", "label": "Before image" },
    { "type": "image_picker", "id": "image_after", "label": "After image" },
    { "type": "text", "id": "label_before", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "label_after", "label": "After label", "default": "After" }
  ],
  "presets": [{ "name": "Before / after" }]
}
{% endschema %}
