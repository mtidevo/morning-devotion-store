{% comment %} FAQ section, restyled to match the v2 concept {% endcomment %}
<section id="faq" class="v2q">
  <style>
    .v2q { --cream:#f6efe2; --cream2:#efe5d2; --ink:#231d15; --mute:#6f6455; --gold:#a8843f; background:var(--cream2); color:var(--ink); padding:clamp(70px,10vw,130px) 0; }
    .v2q * { box-sizing:border-box; }
    .v2q__wrap { width:min(1240px, 100% - 40px); margin:0 auto; display:grid; grid-template-columns:1fr 1.5fr; gap:clamp(30px,6vw,90px); align-items:start; }
    .v2q__head { position:sticky; top:110px; }
    .v2q__eyebrow { font-family:var(--sans, 'Jost', sans-serif); font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); margin:0 0 14px; }
    .v2q h2 { font-family:var(--disp, 'Bodoni Moda', serif); font-weight:400; font-size:clamp(34px,4.4vw,58px); line-height:1.05; margin:0 0 20px; }
    .v2q__lede { color:var(--mute); font-size:17px; line-height:1.75; margin:0; }
    .v2q__lede a { color:var(--ink); text-decoration:underline; text-underline-offset:4px; text-decoration-color:var(--gold); }
    .v2q__list { border-top:1px solid rgba(35,29,21,.16); }
    .v2q details { border-bottom:1px solid rgba(35,29,21,.16); }
    .v2q summary { list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:20px; padding:24px 0; font-family:var(--disp, 'Bodoni Moda', serif); font-size:clamp(20px,1.8vw,24px); line-height:1.3; }
    .v2q summary::-webkit-details-marker { display:none; }
    .v2q__icon { flex:none; width:38px; height:38px; border-radius:50%; border:1px solid rgba(35,29,21,.25); position:relative; transition:background .3s, transform .4s cubic-bezier(.2,.8,.2,1); }
    .v2q__icon::before, .v2q__icon::after { content:""; position:absolute; left:50%; top:50%; width:13px; height:1.5px; background:currentColor; transform:translate(-50%,-50%); }
    .v2q__icon::after { transform:translate(-50%,-50%) rotate(90deg); transition:transform .4s; }
    .v2q details[open] .v2q__icon { background:#1d1812; color:#f6efe2; }
    .v2q details[open] .v2q__icon::after { transform:translate(-50%,-50%) rotate(0deg); }
    .v2q__a { color:var(--mute); font-size:16px; line-height:1.75; padding:0 56px 26px 0; }
    .v2q__a p { margin:0 0 10px; }
    .v2q__a a { color:var(--ink); text-decoration:underline; text-underline-offset:3px; }
    .v2q details[open] .v2q__a { animation:v2qin .5s cubic-bezier(.2,.8,.2,1); }
    @keyframes v2qin { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:none; } }
    @media (max-width: 860px) { .v2q__wrap { grid-template-columns:1fr; } .v2q__head { position:static; } .v2q__a { padding-right:0; } }
  </style>
  <div class="v2q__wrap">
    <div class="v2q__head">
      <p class="v2q__eyebrow">Answers</p>
      <h2>{{ section.settings.heading | default: 'Questions before your first bag.' }}</h2>
      <p class="v2q__lede">{{ section.settings.description }} <a href="mailto:{{ settings.contact_email | default: shop.email }}">{{ settings.contact_email | default: shop.email }}</a>.</p>
    </div>
    <div class="v2q__list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary><span>{{ block.settings.question }}</span><span class="v2q__icon" aria-hidden="true"></span></summary>
          <div class="v2q__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions before your first bag." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "The things people ask us over email, in one place. If your question is not here, we read every reply at" }
  ],
  "blocks": [
    { "type": "faq_item", "name": "FAQ item", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "When does my bag ship?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>One-time orders roast within 2 business days and arrive in about a week.</p>" }
    ] }
  ],
  "presets": [ { "name": "FAQ" } ]
}
{% endschema %}
