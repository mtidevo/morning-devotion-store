{% comment %} 404 template section {% endcomment %}
<section class="page-section text-center">
  <div class="wrap">
    <span class="rule">404</span>
    <h1 class="mb-6">Page not found</h1>
    <p class="text-sm text-mute mb-6">The page you were looking for does not exist or has moved.</p>
    <a href="{{ routes.root_url }}" class="btn btn-gold">Back to home</a>
  </div>
</section>

{% schema %}
{
  "name": "Main 404",
  "settings": []
}
{% endschema %}
