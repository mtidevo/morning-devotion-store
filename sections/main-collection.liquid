{% comment %} Main collection template section {% endcomment %}
<section class="page-section">
  <div class="wrap">
    <span class="rule">{{ collection.title }}</span>
    <h1 class="mb-4">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p class="lede mb-8 max-w-md">{{ collection.description }}</p>
    {% endif %}

    {% if collection.products.size > 0 %}
      <div class="pricing-grid">
        {% for product in collection.products %}
          <article class="product-card">
            <a href="{{ product.url }}" class="product-card-image">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="600" height="450">
              {% else %}
                <div class="product-card-placeholder">
                  {% render 'icon-shopping-bag' %}
                </div>
              {% endif %}
            </a>

            <div class="product-card-content">
              <a href="{{ product.url }}" class="product-card-title no-underline">
                <h3>{{ product.title }}</h3>
              </a>
              <p class="product-card-desc">{{ product.description | strip_html | truncatewords: 25 }}</p>
              <div class="product-card-price">
                <div class="product-card-price-amount">{{ product.price | money }}</div>
                <div class="product-card-price-label">per bag</div>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-mute">No products found in this collection.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main collection",
  "settings": []
}
{% endschema %}
