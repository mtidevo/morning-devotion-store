{% comment %}
  Christmas gift basket banner. Thin dated bar above the header.
  Hides itself after the end date (checked in Liquid at render time and again in the browser),
  before the start date, and once a visitor dismisses it (remembered in localStorage).
{% endcomment %}
{%- liquid
  assign now_s = 'now' | date: '%s' | plus: 0
  assign show = section.settings.enabled
  if section.settings.start_at != blank
    assign start_s = section.settings.start_at | date: '%s' | plus: 0
    if now_s < start_s
      assign show = false
    endif
  endif
  if section.settings.end_at != blank
    assign end_s = section.settings.end_at | date: '%s' | plus: 0
    if now_s > end_s
      assign show = false
    endif
  endif
  if request.design_mode and section.settings.enabled
    assign show = true
  endif
  assign link = section.settings.link | default: '/#gift-baskets'
  assign dismiss_key = 'fem-gb-banner-' | append: section.settings.dismiss_version
-%}
{%- if show -%}
<div class="gbb" id="gbb-{{ section.id }}" role="region" aria-label="{{ section.settings.region_label | escape }}"
  data-gbb data-gbb-start="{{ section.settings.start_at | escape }}" data-gbb-end="{{ section.settings.end_at | escape }}" data-gbb-key="{{ dismiss_key }}" data-gbb-editor="{{ request.design_mode }}"
  style="--gbb-bg:{{ section.settings.bg_color }};--gbb-fg:{{ section.settings.text_color }};">
  <script>
    (function () {
      try { if (localStorage.getItem('{{ dismiss_key }}') === '1' && !{{ request.design_mode | json }}) document.getElementById('gbb-{{ section.id }}').hidden = true; } catch (e) {}
    })();
  </script>
  <style>
    .gbb { background:var(--gbb-bg); color:var(--gbb-fg); font-family:var(--sans, 'Jost', system-ui, sans-serif); position:relative; z-index:60; }
    .gbb[hidden] { display:none; }
    .gbb__inner { display:flex; align-items:center; justify-content:center; gap:10px; min-height:38px; padding:0 48px 0 16px; max-width:100%; }
    .gbb__link { display:flex; align-items:center; gap:10px; min-width:0; color:inherit; text-decoration:none; font-size:13.5px; letter-spacing:.02em; line-height:1.3; }
    .gbb__text { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; }
    .gbb__cta { white-space:nowrap; flex:none; text-decoration:underline; text-underline-offset:3px; text-decoration-thickness:1px; font-weight:500; }
    .gbb__link:hover .gbb__cta, .gbb__link:focus-visible .gbb__cta { text-decoration-thickness:2px; }
    .gbb__link:focus-visible, .gbb__close:focus-visible { outline:2px solid currentColor; outline-offset:3px; border-radius:4px; }
    .gbb__close { position:absolute; right:8px; top:50%; transform:translateY(-50%); width:32px; height:32px; display:grid; place-items:center; border:0; background:transparent; color:inherit; cursor:pointer; border-radius:50%; font-size:20px; line-height:1; }
    .gbb__close:hover { background:rgba(255,255,255,.12); }
    @media (max-width: 640px) {
      .gbb__inner { justify-content:flex-start; padding-left:14px; }
      .gbb__link { font-size:12px; gap:8px; }
    }
  </style>
  <div class="gbb__inner">
    <a class="gbb__link" href="{{ link }}">
      <span class="gbb__text">{{ section.settings.text }}</span>
      {%- if section.settings.link_label != blank -%}<span class="gbb__cta">{{ section.settings.link_label }}</span>{%- endif -%}
    </a>
    {%- if section.settings.dismissible -%}
      <button type="button" class="gbb__close" aria-label="{{ section.settings.close_label | escape }}" data-gbb-close>&times;</button>
    {%- endif -%}
  </div>
  <script>
    (function () {
      var el = document.getElementById('gbb-{{ section.id }}');
      if (!el) return;
      var editor = el.getAttribute('data-gbb-editor') === 'true';
      function t(v) { var n = v ? Date.parse(v) : NaN; return isNaN(n) ? null : n; }
      var now = Date.now(), start = t(el.getAttribute('data-gbb-start')), end = t(el.getAttribute('data-gbb-end'));
      if (!editor && ((start && now < start) || (end && now > end))) { el.hidden = true; return; }
      if (end && !editor) { setTimeout(function () { el.hidden = true; }, Math.min(end - now, 2147483000)); }
      var btn = el.querySelector('[data-gbb-close]');
      if (btn) btn.addEventListener('click', function () {
        el.hidden = true;
        try { localStorage.setItem(el.getAttribute('data-gbb-key'), '1'); } catch (e) {}
      });
    })();
  </script>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Gift basket banner",
  "class": "gbb-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show banner", "default": true },
    { "type": "text", "id": "text", "label": "Message", "default": "🎄 Christmas Morning Gift Baskets are here. Save $14, order by Dec 7 for Christmas delivery." },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop baskets →" },
    { "type": "url", "id": "link", "label": "Link", "info": "Leave blank to jump to the gift basket section on the homepage." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#334538" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F8F6F0" },
    { "type": "header", "content": "Schedule" },
    { "type": "text", "id": "start_at", "label": "Start date and time", "info": "Format: 2026-11-14T00:00:00-05:00 (the -05:00 is Eastern time). Leave blank to start now.", "default": "2026-11-14T00:00:00-05:00" },
    { "type": "text", "id": "end_at", "label": "End date and time", "info": "The banner hides itself after this. Format: 2026-12-07T23:59:59-05:00", "default": "2026-12-07T23:59:59-05:00" },
    { "type": "header", "content": "Dismiss" },
    { "type": "checkbox", "id": "dismissible", "label": "Let visitors close the banner", "default": true },
    { "type": "text", "id": "dismiss_version", "label": "Dismiss version", "default": "xmas-2026", "info": "Change this when you change the message, so visitors who closed the old one see the new one." },
    { "type": "text", "id": "close_label", "label": "Close button label (screen readers)", "default": "Close announcement" },
    { "type": "text", "id": "region_label", "label": "Region label (screen readers)", "default": "Christmas gift basket announcement" }
  ],
  "presets": [{ "name": "Gift basket banner" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
