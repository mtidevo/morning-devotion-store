{% comment %} Main blog template section {% endcomment %}
<section class="page-section">
  <div class="wrap">
    <span class="rule">{{ blog.title }}</span>
    <h1 class="mb-6">{{ blog.title }}</h1>

    {% if blog.articles.size > 0 %}
      <div class="fundraiser-grid">
        {% for article in blog.articles %}
          <article class="fundraiser-card">
            <h3>
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>
            <p class="text-sm text-mute">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
            <a href="{{ article.url }}" class="btn btn-edge btn-sm">Read more</a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-mute">No posts yet.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": []
}
{% endschema %}
