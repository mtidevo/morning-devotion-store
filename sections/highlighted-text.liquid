{% comment %} Highlighted text — headline with hand-drawn circle around key phrase {% endcomment %}
{%- assign heading = section.settings.heading -%}
{%- assign hl = section.settings.highlight -%}
<section class="band highlighted-text-section">
  <div class="wrap highlighted-text-grid">
    <div>
      <span class="rule">{{ section.settings.eyebrow | default: 'Our promise' }}</span>
      <h2 class="highlighted-text-heading">
        {%- if hl != blank and heading contains hl -%}
          {%- assign parts = heading | split: hl -%}
          {{ parts[0] }}<span class="hl-circle">{{ hl }}{% render 'circle-underline' %}</span>{{ parts[1] }}
        {%- else -%}
          {{ heading }}
        {%- endif -%}
      </h2>
    </div>
    <div class="highlighted-text-body lede">
      {{ section.settings.body }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Highlighted text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Written once. Never reprinted." },
    { "type": "text", "id": "highlight", "label": "Word or phrase to circle (must appear in heading)", "default": "Never reprinted" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Every devotion on the back of every bag is written for one month, printed on that month's bag, then retired. What arrives at your door won't arrive again. The morning stays fresh because it never repeats.</p>" }
  ],
  "presets": [ { "name": "Highlighted text" } ]
}
{% endschema %}
