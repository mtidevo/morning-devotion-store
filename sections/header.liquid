{% comment %} Header — sticky white nav with search / account / cart {% endcomment %}
<header class="site-header" role="banner" data-site-header>
  <div class="header-inner">
    <a href="{{ routes.root_url }}" class="header-logo" aria-label="{{ settings.brand_name }} home">
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: 160 }}" alt="{{ settings.brand_name }}" width="56" height="56">
      {% endif %}
      <span class="header-wordmark">{{ settings.brand_name }}</span>
    </a>

    <nav class="header-nav" role="navigation" aria-label="Main">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="nav-link{% if link.active %} is-active{% endif %}" data-nav-link data-nav-title="{{ link.title | escape | downcase }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="header-actions">
      {% if section.settings.show_localization and localization.available_countries.size > 1 %}
        <details class="header-locale">
          <summary aria-label="Region and language">{{ localization.country.iso_code }} / {{ localization.language.iso_code | upcase }}</summary>
          <div class="header-locale-panel">
            {% form 'localization', class: 'header-locale-form' %}
              <select name="country_code" onchange="this.form.submit()" aria-label="Country">
                {% for country in localization.available_countries %}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>
                {% endfor %}
              </select>
              <select name="language_code" onchange="this.form.submit()" aria-label="Language">
                {% for lang in localization.available_languages %}
                  <option value="{{ lang.iso_code }}" {% if lang.iso_code == localization.language.iso_code %}selected{% endif %}>{{ lang.endonym_name }}</option>
                {% endfor %}
              </select>
            {% endform %}
          </div>
        </details>
      {% endif %}
      <button type="button" class="header-icon-btn" aria-label="Search" data-search-open>
        {% render 'icon-search' %}
      </button>
      <a href="{{ section.settings.account_url | default: routes.account_url }}" class="header-icon-btn" aria-label="Account">
        {% render 'icon-user' %}
      </a>
      <a href="{{ routes.cart_url }}" class="header-icon-btn cart-link" aria-label="Cart">
        {% render 'icon-shopping-bag' %}
        {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
      <button class="header-icon-btn mobile-menu-toggle" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" hidden>
    {% for link in linklists[section.settings.menu].links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
    <a href="{{ section.settings.account_url | default: routes.account_url }}">Account</a>
    <a href="{{ routes.cart_url }}">Cart</a>
  </div>

  <div class="search-overlay" hidden data-search-overlay>
    <div class="search-overlay-inner">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <input type="search" name="q" placeholder="Search coffee, devotions, journal…" autocomplete="off" aria-label="Search">
        <button type="submit" aria-label="Submit search">{% render 'icon-search' %}</button>
      </form>
      <button type="button" class="search-close" aria-label="Close search" data-search-close>&times;</button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "url", "id": "account_url", "label": "Account URL (e.g. account.foreverymorning.com)" },
    { "type": "checkbox", "id": "show_localization", "label": "Show country / language switcher", "default": false }
  ]
}
{% endschema %}
