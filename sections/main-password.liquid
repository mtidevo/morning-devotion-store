{% comment %} Password template section {% endcomment %}
<section class="page-section text-center" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
  <div class="wrap narrow">
    <span class="rule">Coming soon</span>
    <h1 class="mb-6">{{ shop.name }}</h1>
    <p class="text-sm text-mute mb-6">Our store is opening soon. Enter your email to be notified.</p>

    {% form 'customer', class: 'email-form' %}
      <input type="email" name="contact[email]" class="email-field" placeholder="Your email address" required aria-label="Email address">
      <button type="submit" class="btn btn-gold">Notify me</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Main password",
  "settings": []
}
{% endschema %}
