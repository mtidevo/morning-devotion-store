{% comment %} Hero — full-bleed image with overlay text and floating rail {% endcomment %}
<section id="top" class="hero-full" data-hero>
  {% render 'floating-rail' %}

  <div class="hero-full-media">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager" fetchpriority="high">
    {% else %}
      <div class="hero-full-fallback"></div>
    {% endif %}
    <div class="hero-full-scrim"></div>
  </div>

  <div class="hero-full-content">
    <div class="wrap">
      {% if section.settings.eyebrow != blank %}
        <span class="hero-full-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1 class="hero-full-title">{{ section.settings.heading | default: 'Coffee with something underneath it.' }}</h1>
      {% if section.settings.description != blank %}
        <p class="hero-full-lede">{{ section.settings.description }}</p>
      {% endif %}
      <div class="hero-full-actions">
        <a href="{{ section.settings.primary_cta_url | default: '#coffee' }}" class="btn btn-gold">{{ section.settings.primary_cta_text | default: 'Shop this month' }}</a>
        {% if section.settings.secondary_cta_text != blank %}
          <a href="{{ section.settings.secondary_cta_url | default: '#devotion' }}" class="btn btn-ghost-light">{{ section.settings.secondary_cta_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No. 01 · August · Morning Mercies" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coffee with something underneath it." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Specialty coffee with a new devotion and prayer on the back of every bag. Written once. Never reprinted." },
    { "type": "text", "id": "primary_cta_text", "label": "Primary CTA", "default": "Shop this month" },
    { "type": "url", "id": "primary_cta_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "secondary_cta_text", "label": "Secondary CTA", "default": "Read the devotion" },
    { "type": "url", "id": "secondary_cta_url", "label": "Secondary CTA URL" }
  ]
}
{% endschema %}
