      "label": "Description",
      "default": "Specialty coffee with a new devotion and prayer on the back of every bag. Written once. Never reprinted. Shows up before you have to think about it."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA text",
      "default": "Start a morning · from $22"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA text",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "header",
      "content": "Devotion panel"
    },
    {
      "type": "text",
      "id": "devotion_number",
      "label": "Issue number",
      "default": "No. 01"
    },
    {
      "type": "text",
      "id": "devotion_month",
      "label": "Month",
      "default": "August"
    },
    {
      "type": "text",
      "id": "devotion_title",
      "label": "Devotion title",
      "default": "Morning Mercies"
    },
    {
      "type": "text",
      "id": "devotion_author",
      "label": "Author line",
      "default": "Written by Alex Lambert"
    },
    {
      "type": "textarea",
      "id": "devotion_verse",
      "label": "Verse",
      "default": "Because of the Lord's great love we are not consumed, for his compassions never fail. They are new every morning."
    },
    {
      "type": "text",
      "id": "devotion_citation",
