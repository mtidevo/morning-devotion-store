{% comment %} Hero section with devotion panel {% endcomment %}
<section id="top" class="hero-section band band-deep">
  <div class="wrap hero-grid">
    <div>
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: 460 }}" alt="{{ settings.brand_name }}" class="hero-logo" loading="eager">
      {% endif %}

      <div class="hero-badge">
        {% render 'icon-sparkles' %}
        <span>{{ section.settings.badge_text | default: 'No. 01 · August · Morning Mercies' }}</span>
      </div>

      <h1 class="hero-title">
        {{ section.settings.heading | default: 'Coffee with ' }}<em class="italic">{{ section.settings.heading_emphasis | default: 'something underneath it.' }}</em>
      </h1>

      <p class="lede mt-5 max-w-md">
        {{ section.settings.description | default: 'Specialty coffee with a new devotion and prayer on the back of every bag. Written once. Never reprinted. Shows up before you have to think about it.' }}
      </p>

      <div class="hero-actions">
        <a href="{{ section.settings.primary_cta_url | default: '#coffee' }}" class="btn btn-gold">{{ section.settings.primary_cta_text | default: 'Start a morning · from $22' }}</a>
        <a href="{{ section.settings.secondary_cta_url | default: '#idea' }}" class="btn btn-edge">{{ section.settings.secondary_cta_text | default: 'How it works' }}</a>
      </div>

      <div class="hero-trust">
        <span>
          {% render 'icon-book' %}
          Written by pastors we know
        </span>
        <span>
          <span style="display: inline-block; width: 4px; height: 4px; border-radius: 50%; background: var(--gold);"></span>
          Roasted in Bend, Oregon
        </span>
        <span>
          <span style="display: inline-block; width: 4px; height: 4px; border-radius: 50%; background: var(--gold);"></span>
          Cancel any month
        </span>
      </div>
    </div>

    <div>
      {% render 'devotion-panel',
        number: section.settings.devotion_number | default: 'No. 01',
        month: section.settings.devotion_month | default: 'August',
        title: section.settings.devotion_title | default: 'Morning Mercies',
        author: section.settings.devotion_author | default: 'Written by Alex Lambert',
        verse: section.settings.devotion_verse | default: 'Because of the Lord\'s great love we are not consumed, for his compassions never fail. They are new every morning.',
        citation: section.settings.devotion_citation | default: 'Lamentations 3 : 22–23',
        body: section.settings.devotion_body | default: 'Jeremiah wrote that looking at a burned city. Not from a good week. Not with anything resolved.\n\nWhatever yesterday cost you, it did not carry over. The mercy waiting this morning is not the remainder of yesterday\'s. It is new, it is enough for today, and there is no version of you too far behind to receive it.' | newline_to_br | split: '<br />',
        prayer: section.settings.devotion_prayer | default: 'Father, I have carried yesterday into this kitchen with me. Take it. Let me start here, with what is new, and let me be slow to pick it back up.',
        brand: settings.brand_name,
        bagline: section.settings.devotion_bagline | default: '12 oz · Whole bean'
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
