{% comment %} Lookbook with hotspots {% endcomment %}
{%- assign first_block = section.blocks[0] -%}
<section class="lookbook">
  <div class="wrap">
    <div class="lookbook-header">
      {% if section.settings.eyebrow != blank %}<span class="rule">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="lookbook-heading">
        {{ section.settings.heading | default: 'Bring Quality Sound into Your Home' }}
        {% render 'underline-scribble' %}
      </h2>
    </div>

    <div class="lookbook-grid" data-lookbook>
      <div class="lookbook-image">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
        {% else %}
          <div class="lookbook-fallback"></div>
        {% endif %}

        {% for block in section.blocks %}
          <button type="button"
                  class="lookbook-hotspot{% if forloop.first %} is-active{% endif %}"
                  style="left: {{ block.settings.x | default: 50 }}%; top: {{ block.settings.y | default: 50 }}%;"
                  data-lookbook-hotspot="{{ block.id }}"
                  aria-label="{{ block.settings.product.title | default: 'View product' | escape }}"
                  {{ block.shopify_attributes }}>
            <span class="lookbook-hotspot-dot"></span>
          </button>
        {% endfor %}
      </div>

      <div class="lookbook-cards">
        {% for block in section.blocks %}
          {%- assign product = block.settings.product -%}
          <article class="lookbook-card{% if forloop.first %} is-active{% endif %}" data-lookbook-card="{{ block.id }}">
            {% if product != blank %}
              <a href="{{ product.url }}" class="lookbook-card-media">
                {% if product.featured_image != blank %}
                  <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy">
                {% endif %}
              </a>
              <div class="lookbook-card-body">
                <div class="lookbook-card-eyebrow">{{ product.type | default: 'Featured' }}</div>
                <h3 class="lookbook-card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <div class="lookbook-card-price">{{ product.price | money }}</div>
                <a href="{{ product.url }}" class="lookbook-card-cta">Choose options</a>
              </div>
            {% else %}
              <div class="lookbook-card-body">
                <h3 class="lookbook-card-title">Pick a product</h3>
                <p class="text-mute text-sm">Set a product for this hotspot in the theme editor.</p>
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring Quality Sound into Your Home" },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "x", "label": "X position (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Y position (%)", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 40, "y": 65 } },
        { "type": "hotspot", "settings": { "x": 65, "y": 45 } }
      ]
    }
  ]
}
{% endschema %}
