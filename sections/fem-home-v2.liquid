</div>

<script>
  (function(){
    var root = document.currentScript.previousElementSibling;
    var els = root.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .15, rootMargin: '0px 0px -40px 0px' });
      els.forEach(function(el){ io.observe(el); });
    } else { els.forEach(function(el){ el.classList.add('in'); }); }
    var track = root.querySelector('[data-rail-track]');
    root.querySelectorAll('[data-rail]').forEach(function(b){ b.addEventListener('click', function(){ track.scrollBy({ left: track.clientWidth * 0.8 * Number(b.dataset.rail), behavior: 'smooth' }); }); });
    var par = root.querySelectorAll('[data-parallax]');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var tick = false;
      window.addEventListener('scroll', function(){ if (tick) return; tick = true; requestAnimationFrame(function(){ par.forEach(function(p){ var r = p.parentElement.getBoundingClientRect(); var pct = (r.top + r.height/2 - innerHeight/2) / innerHeight; p.style.transform = 'translate3d(0,' + (pct * -60) + 'px,0)'; }); tick = false; }); }, { passive: true });
    }
  })();
</script>

