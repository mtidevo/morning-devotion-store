{% comment %} Side cart. The [data-cd-body] part is re-rendered with the Section Rendering API after every cart change. Script lives in snippets/cart-drawer-script.liquid. {% endcomment %}
<div class="cd" data-cd aria-hidden="true">
  <style>
    .cd { --cream:#f6efe2; --ink:#231d15; --mute:#6f6455; --gold:#a8843f; --hair:rgba(35,29,21,.12); position:fixed; inset:0; z-index:1000; pointer-events:none; }
    .cd__overlay { position:absolute; inset:0; background:rgba(29,24,18,.38); opacity:0; transition:opacity .35s; }
    .cd__panel { position:absolute; top:0; right:0; bottom:0; width:min(440px, 100%); background:var(--cream); color:var(--ink); display:flex; flex-direction:column; transform:translateX(100%); transition:transform .45s cubic-bezier(.2,.8,.2,1); box-shadow:-30px 0 60px -30px rgba(20,14,8,.45); }
    .cd.is-open { pointer-events:auto; }
    .cd.is-open .cd__overlay { opacity:1; }
    .cd.is-open .cd__panel { transform:none; }
    .cd__head { display:flex; align-items:center; justify-content:space-between; padding:22px 24px 16px; border-bottom:1px solid var(--hair); }
    .cd__head h2 { font-family:var(--disp, 'Bodoni Moda', serif); font-weight:400; font-size:28px; margin:0; }
    .cd__head h2 small { font-family:var(--sans, 'Jost', sans-serif); font-size:13px; color:var(--mute); margin-left:6px; }
    .cd__close { width:40px; height:40px; border-radius:50%; border:1px solid var(--hair); background:#fff; cursor:pointer; font-size:20px; line-height:1; color:var(--ink); }
    .cd__body { flex:1; display:flex; flex-direction:column; min-height:0; }
    .cd__ship { padding:14px 24px 0; }
    .cd__ship .ship-bar { margin:0; }
    .cd__items { flex:1; overflow-y:auto; padding:8px 24px; list-style:none; margin:0; }
    .cd__item { display:grid; grid-template-columns:76px 1fr auto; gap:14px; padding:16px 0; border-bottom:1px solid var(--hair); align-items:start; }
    .cd__img { width:76px; height:76px; border-radius:12px; background:#fff; object-fit:contain; border:1px solid var(--hair); }
    .cd__title { font-family:var(--disp, 'Bodoni Moda', serif); font-size:19px; line-height:1.2; color:var(--ink); text-decoration:none; }
    .cd__meta { font-size:12.5px; color:var(--mute); margin-top:3px; line-height:1.45; }
    .cd__qty { display:inline-flex; align-items:center; border:1px solid var(--hair); border-radius:999px; margin-top:10px; background:#fff; }
    .cd__qty button { width:32px; height:32px; border:0; background:transparent; cursor:pointer; font-size:16px; color:var(--ink); }
    .cd__qty span { min-width:22px; text-align:center; font-size:14px; }
    .cd__price { font-size:15px; text-align:right; white-space:nowrap; }
    .cd__price s { display:block; color:var(--mute); font-size:12.5px; }
    .cd__remove { display:block; margin-top:10px; background:none; border:0; padding:0; font-size:12px; color:var(--mute); text-decoration:underline; cursor:pointer; }
    .cd__empty { padding:48px 24px; text-align:center; color:var(--mute); }
    .cd__empty .btn, .cd__foot .btn { width:100%; justify-content:center; }
    .cd__foot { padding:18px 24px calc(18px + env(safe-area-inset-bottom)); border-top:1px solid var(--hair); background:#fff; }
    .cd__total { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:4px; }
    .cd__total strong { font-family:var(--disp, 'Bodoni Moda', serif); font-weight:400; font-size:26px; }
    .cd__fine { font-size:12.5px; color:var(--mute); margin:0 0 14px; }
    .cd__view { display:block; text-align:center; margin-top:12px; font-size:13px; color:var(--ink); text-decoration:underline; text-underline-offset:4px; text-decoration-color:var(--gold); }
    .cd__error { margin:10px 24px 0; padding:10px 14px; border-radius:10px; background:rgba(122,43,43,.08); color:#7a2b2b; font-size:13.5px; }
    .cd.is-busy .cd__items, .cd.is-busy .cd__foot { opacity:.55; pointer-events:none; }
    body.cd-lock { overflow:hidden; }
    @media (prefers-reduced-motion: reduce) { .cd__panel, .cd__overlay { transition:none; } }
  </style>
  <div class="cd__overlay" data-cd-close></div>
  <div class="cd__panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <div class="cd__body" data-cd-body data-count="{{ cart.item_count }}">
      <div class="cd__head">
        <h2>Your cart{% if cart.item_count > 0 %}<small>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</small>{% endif %}</h2>
        <button type="button" class="cd__close" aria-label="Close cart" data-cd-close>&times;</button>
      </div>
      <div data-cd-error></div>
      {%- if cart.item_count == 0 -%}
        <div class="cd__empty">
          <p>Your cart is empty.</p>
          <a href="/collections/coffee" class="btn btn-gold mt-4">Shop the coffee</a>
        </div>
      {%- else -%}
        <div class="cd__ship">{% render 'shipping-bar' %}</div>
        <ul class="cd__items">
          {%- for item in cart.items -%}
            <li class="cd__item">
              <a href="{{ item.url }}">
                {%- if item.image != blank -%}<img class="cd__img" src="{{ item.image | image_url: width: 180 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="76" height="76" loading="lazy">{%- endif -%}
              </a>
              <div>
                <a class="cd__title" href="{{ item.url }}">{{ item.product.title }}</a>
                <div class="cd__meta">
                  {%- for p in item.properties -%}{%- assign pk = p.first | slice: 0 -%}{%- if p.last != blank and pk != '_' -%}{{ p.first }}: {{ p.last }}<br>{%- endif -%}{%- endfor -%}
                  {%- unless item.product.has_only_default_variant -%}{{ item.variant.title }}<br>{%- endunless -%}
                  {%- if item.selling_plan_allocation -%}Subscribe &amp; save: {{ item.selling_plan_allocation.selling_plan.name }}{%- elsif item.product.type == 'Coffee' -%}One-time purchase{%- elsif item.product.tags contains settings.gb_picker_tag -%}{{ settings.gb_cart_note }}{%- else -%}Ships separately from our partner{%- endif -%}
                </div>
                <div class="cd__qty">
                  <button type="button" aria-label="Remove one" data-cd-line="{{ forloop.index }}" data-cd-qty="{{ item.quantity | minus: 1 }}">&minus;</button>
                  <span>{{ item.quantity }}</span>
                  <button type="button" aria-label="Add one" data-cd-line="{{ forloop.index }}" data-cd-qty="{{ item.quantity | plus: 1 }}">+</button>
                </div>
              </div>
              <div class="cd__price">
                {{ item.final_line_price | money }}
                {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                <button type="button" class="cd__remove" data-cd-line="{{ forloop.index }}" data-cd-qty="0">Remove</button>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div style="padding:0 24px">{% render 'gift-basket-cart-addon' %}</div>
        <div class="cd__foot">
          <div class="cd__total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="cd__fine">Shipping and discounts are calculated at checkout.</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="btn btn-gold">Checkout</button>
          </form>
          <a class="cd__view" href="{{ routes.cart_url }}">View full cart</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
