{% comment %} Guarantee band, restyled to match the v2 concept {% endcomment %}
<section class="v2g">
  <style>
    .v2g { --cream:#f6efe2; --ink:#231d15; --mute:#6f6455; --gold:#a8843f; --gold-l:#d8b878; background:var(--cream); color:var(--ink); padding:clamp(70px,10vw,130px) 0; }
    .v2g * { box-sizing:border-box; }
    .v2g__wrap { width:min(1100px, 100% - 40px); margin:0 auto; display:grid; grid-template-columns:auto 1fr; gap:clamp(30px,6vw,80px); align-items:center; }
    .v2g__seal { width:clamp(150px,18vw,210px); aspect-ratio:1; position:relative; }
    .v2g__seal svg { width:100%; height:100%; animation:v2gspin 40s linear infinite; }
    .v2g__seal-core { position:absolute; inset:22%; border-radius:50%; background:var(--gold); color:#fff; display:grid; place-items:center; text-align:center; font-family:var(--disp, 'Bodoni Moda', serif); font-size:clamp(15px,1.6vw,19px); line-height:1.15; padding:10px; box-shadow:0 18px 40px -18px rgba(120,85,30,.7); }
    @keyframes v2gspin { to { transform:rotate(360deg); } }
    .v2g__eyebrow { font-family:var(--sans, 'Jost', sans-serif); font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); margin:0 0 14px; }
    .v2g h2 { font-family:var(--disp, 'Bodoni Moda', serif); font-weight:400; font-size:clamp(34px,4.4vw,58px); line-height:1.05; margin:0 0 18px; max-width:18ch; }
    .v2g__body { color:var(--mute); font-size:17px; line-height:1.75; margin:0 0 26px; max-width:56ch; }
    .v2g__points { display:flex; flex-wrap:wrap; gap:10px 26px; list-style:none; padding:0; margin:0 0 26px; font-family:var(--sans, 'Jost', sans-serif); font-size:13px; letter-spacing:.12em; text-transform:uppercase; }
    .v2g__points li { display:flex; gap:8px; align-items:center; }
    .v2g__points li::before { content:"✦"; color:var(--gold); }
    .v2g__link { color:var(--ink); font-size:14px; text-decoration:underline; text-underline-offset:5px; text-decoration-color:var(--gold); }
    @media (max-width: 760px) { .v2g__wrap { grid-template-columns:1fr; justify-items:start; } }
    @media (prefers-reduced-motion: reduce) { .v2g__seal svg { animation:none; } }
  </style>
  <div class="v2g__wrap">
    <div class="v2g__seal" aria-hidden="true">
      <svg viewBox="0 0 200 200"><defs><path id="v2gring" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0"/></defs><text font-family="Jost, sans-serif" font-size="13" fill="#a8843f"><textPath href="#v2gring" textLength="508" lengthAdjust="spacing">FIRST BAG PROMISE ✦ LOVE IT OR WE MAKE IT RIGHT ✦</textPath></text></svg>
      <div class="v2g__seal-core">Love it<br>or we make<br>it right</div>
    </div>
    <div>
      <p class="v2g__eyebrow">{{ section.settings.label | default: 'Our promise' }}</p>
      <h2>{{ section.settings.heading | default: 'Love your first bag, or we make it right.' }}</h2>
      <p class="v2g__body">{{ section.settings.description }}</p>
      <ul class="v2g__points"><li>Roasted to order</li><li>Free shipping on 2+ bags</li><li>Skip or cancel anytime</li></ul>
      <a class="v2g__link" href="/policies/refund-policy">Read the full refund policy</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Our promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Love your first bag, or we make it right." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "If the coffee or the devotion does not land the way you hoped, email us within 30 days. We will refund the bag or send a replacement, no script, no waiting." }
  ]
}
{% endschema %}
