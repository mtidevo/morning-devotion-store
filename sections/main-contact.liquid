{% comment %} Contact page: page content plus a Shopify contact form, styled to match the box builder card {% endcomment %}
<section class="fc">
  <style>
    .fc { --cream:#f6efe2; --cream2:#efe5d2; --ink:#231d15; --mute:#6f6455; --gold:#a8843f; --gold-l:#d8b878; background:var(--cream); color:var(--ink); padding:clamp(50px,7vw,100px) 0 clamp(70px,9vw,120px); }
    .fc * { box-sizing:border-box; }
    .fc__wrap { width:min(1100px, 100% - 40px); margin:0 auto; display:grid; grid-template-columns:1fr 1.15fr; gap:clamp(30px,5vw,70px); align-items:start; }
    .fc__eyebrow { font-family:var(--sans); font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); margin:0 0 12px; }
    .fc h1 { font-family:var(--disp); font-weight:400; font-size:clamp(40px,5vw,68px); line-height:1.02; margin:0 0 16px; }
    .fc__rte { color:var(--mute); font-size:17px; line-height:1.7; }
    .fc__rte a { color:var(--ink); text-decoration-color:var(--gold); text-underline-offset:4px; }
    .fc__list { list-style:none; padding:16px; margin:24px 0 0; display:grid; gap:10px; border-radius:14px; background:var(--cream2); font-size:14px; }
    .fc__list li { display:flex; gap:10px; align-items:center; }
    .fc__list li::before { content:"\2713"; width:18px; height:18px; flex:none; border-radius:50%; background:var(--gold); color:#fff; display:grid; place-items:center; font-size:11px; }
    .fc__card { background:#fff; border:1px solid rgba(35,29,21,.1); border-radius:24px; padding:clamp(24px,4vw,40px); box-shadow:0 30px 60px -40px rgba(40,25,10,.35); }
    .fc__card h2 { font-family:var(--disp); font-weight:400; font-size:30px; margin:0 0 18px; }
    .fc form { display:grid; gap:14px; }
    .fc label { display:flex; flex-direction:column; gap:6px; font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--mute); }
    .fc input, .fc textarea { font:inherit; font-size:16px; letter-spacing:0; text-transform:none; color:var(--ink); background:#fff; border:1px solid rgba(35,29,21,.18); border-radius:12px; padding:13px 14px; width:100%; transition:border-color .2s, box-shadow .2s; }
    .fc input:focus, .fc textarea:focus { outline:none; border-color:var(--gold); box-shadow:0 0 0 3px rgba(168,132,63,.15); }
    .fc textarea { min-height:150px; resize:vertical; }
    .fc__btn { width:100%; border:0; border-radius:999px; background:var(--gold); color:#fff; padding:17px; font-family:var(--sans); font-size:13px; letter-spacing:.14em; text-transform:uppercase; cursor:pointer; transition:background .3s; }
    .fc__btn:hover { background:#8f6f31; }
    .fc__ok, .fc__err { border-radius:12px; padding:14px 16px; font-size:15px; }
    .fc__ok { background:rgba(168,132,63,.12); border:1px solid var(--gold-l); }
    .fc__err { background:#fbeeee; border:1px solid #d99; color:#7a2b2b; }
    .fc__fine { margin:2px 0 0; font-size:12px; color:var(--mute); text-align:center; }
    @media (max-width: 820px) { .fc__wrap { grid-template-columns:1fr; } }
  </style>
  <div class="fc__wrap">
    <div>
      <p class="fc__eyebrow">{{ page.title }}</p>
      <h1>{{ section.settings.heading | default: 'Get in touch.' }}</h1>
      {% if page.content != blank %}<div class="fc__rte">{{ page.content }}</div>{% endif %}
      <ul class="fc__list">
        <li>Order and shipping questions</li>
        <li>Changes to your subscription</li>
        <li>Fundraisers and bulk orders</li>
      </ul>
    </div>
    <div class="fc__card">
      <h2>Send us a note</h2>
      {% form 'contact', class: 'contact-form' %}
        {% if form.posted_successfully? %}
          <p class="fc__ok" role="status">{{ section.settings.success_text }}</p>
        {% endif %}
        {% if form.errors %}
          <div class="fc__err" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <label for="ContactName">Name<input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
        <label for="ContactEmail">Email *<input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
        <label for="ContactBody">Message<textarea id="ContactBody" name="contact[body]" rows="6">{{ form.body }}</textarea></label>
        <button type="submit" class="fc__btn">{{ section.settings.button_text }}</button>
        <p class="fc__fine">We never share your email.</p>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Send message" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for writing. We read every message and will reply soon." }
  ]
}
{% endschema %}
