{% comment %} Contact page: page content plus a Shopify contact form {% endcomment %}
<section class="page-section contact-section">
  <div class="wrap page-content">
    <span class="rule">{{ page.title }}</span>
    <h1 class="mb-6">{{ section.settings.heading | default: page.title }}</h1>
    {% if page.content != blank %}
      <div class="rte">{{ page.content }}</div>
    {% endif %}

    {% form 'contact', class: 'contact-form' %}
      {% if form.posted_successfully? %}
        <p class="contact-success" role="status">{{ section.settings.success_text }}</p>
      {% endif %}
      {% if form.errors %}
        <div class="contact-errors" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="contact-row">
        <label for="ContactName">Name</label>
        <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="contact-row">
        <label for="ContactEmail">Email <span aria-hidden="true">*</span></label>
        <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
      <div class="contact-row">
        <label for="ContactBody">Message</label>
        <textarea id="ContactBody" name="contact[body]" rows="6">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="btn btn-gold">{{ section.settings.button_text }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Send message" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for writing. We read every message and will reply soon." }
  ]
}
{% endschema %}
