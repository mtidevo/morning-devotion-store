<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_paper }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  <meta name="description" content="{{ page_description | default: shop.description | default: settings.share_description | default: 'Specialty coffee with a new devotion and prayer on the back of every bag.' | escape }}">

  {% render 'meta-tags' %}

  {{ content_for_header }}

  <style>
    :root {
      --paper: {{ settings.color_paper }};
      --paper2: {{ settings.color_paper }};
      --sagetint: {{ settings.color_paper }};
      --ink: {{ settings.color_ink }};
      --mute: {{ settings.color_mute }};
      --espresso: {{ settings.color_espresso }};
      --bark: #322d21;
      --gold-d: {{ settings.color_gold_dark }};
      --gold: {{ settings.color_gold }};
      --gold-l: {{ settings.color_gold_light }};
      --champagne: {{ settings.color_champagne }};
      --sage-d: {{ settings.color_sage_dark }};
      --sage: {{ settings.color_sage }};
      --sage-l: #9ba48d;
    
      --hair: rgba(78, 86, 70, 0.2);
      --hairG: rgba(143, 120, 69, 0.3);
      --hairP: rgba(241, 234, 218, 0.16);
    
      --disp: "Bodoni Moda", Didot, Georgia, serif;
      --sans: "Jost", system-ui, sans-serif;
    }
  </style>

  {{ 'styles.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.theme = {
      shopUrl: {{ shop.url | json }},
      moneyFormat: {{ shop.money_format | json }},
      routes: {
        cart: {{ routes.cart_url | json }},
        cart_add_url: {{ routes.cart_add_url | json }},
        cart_change_url: {{ routes.cart_change_url | json }},
        cart_update_url: {{ routes.cart_update_url | json }},
        predictive_search_url: {{ routes.predictive_search_url | json }}
      }
    };
  </script>

  {%- assign org_description = shop.description | default: settings.share_description | default: 'Specialty coffee with a new devotion and prayer on the back of every bag.' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "description": {{ org_description | json }},
      "url": {{ shop.url | json }},
      {%- if settings.logo != blank -%}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }},
      {%- endif -%}
      "email": {{ settings.contact_email | json }},
      "sameAs": ["https://www.instagram.com/foreverymorning", "https://www.facebook.com/Foreverymorning"],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Wooster",
        "addressRegion": "OH",
        "addressCountry": "US"
      }
    }
  </script>

  {%- if template.name == 'product' and product -%}
    {%- assign ld_variant = product.selected_or_first_available_variant -%}
    {%- assign ld_rating = product.metafields.reviews.rating.value.rating -%}
    {%- assign ld_count = product.metafields.reviews.rating_count.value -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | strip | json }},
        "url": {{ shop.url | append: product.url | json }},
        {%- if product.featured_image != blank -%}
        "image": [{% for img in product.images limit: 4 %}{{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
        {%- endif -%}
        "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
        {%- if ld_variant.sku != blank -%}"sku": {{ ld_variant.sku | json }},{%- endif -%}
        {%- if ld_rating and ld_count and ld_count > 0 -%}
        "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ ld_rating | json }}, "reviewCount": {{ ld_count | json }} },
        {%- endif -%}
        "offers": [
          {%- for v in product.variants -%}
          {
            "@type": "Offer",
            "name": {{ v.title | json }},
            {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
            "price": {{ v.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
            "url": {{ shop.url | append: v.url | json }}
          }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
  {%- if template.name == 'index' -%}{% render 'fem-v2-fixes' %}{%- endif -%}
  {% render 'fem-site' %}
</head>

<body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}">
  <a class="skip-to-content-link" href="#MainContent">
    {{ 'general.accessibility.skip_to_text' | t }}
  </a>

  {% sections 'header-group' %}

  <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}
  {% render 'cart-drawer-script' %}

  <script src="{{ 'site.js' | asset_url }}" defer></script>
</body>
</html>
