{% comment %} Product card snippet for pricing grid {% endcomment %}
{%- liquid
  assign is_carton = false
  if product.type == 'Coffee'
    assign is_carton = true
  endif
  assign rp = product.metafields.fem.roast_profile.value
  if rp == blank or rp.lv == blank
    assign rp = product.metafields.fem.roast_level.value
  endif
  assign roast_label = ''
  if is_carton and rp.lv
    assign lvl_parts = rp.level | split: '-'
    assign lvl = ''
    for part in lvl_parts
      assign cap = part | capitalize
      if forloop.first
        assign lvl = cap
      else
        assign lvl = lvl | append: '-' | append: cap
      endif
    endfor
    if product.description contains '<strong>Decaf'
      assign roast_label = 'Decaf · ' | append: lvl
    else
      assign roast_label = lvl | append: ' Roast'
    endif
  endif
-%}
<article {% render 'card-filter-attrs', product: product %} class="product-card{% if popular %} popular{% endif %}{% if is_carton %} product-card--carton{% endif %}{% if is_carton and product.handle contains '-pods' %} product-card--pods{% endif %}">
  {% if popular %}
    <div class="popular-badge">Start here</div>
  {% endif %}

  <a href="{{ product.url }}" class="product-card-image" aria-label="{{ product.title | escape }}">
    {% if product.featured_image != blank %}
      {%- assign card_alt = product.featured_image.alt -%}
      {%- if card_alt == blank or card_alt == 'Product Image' -%}{%- assign card_alt = product.title | append: ' coffee, 12 oz carton' -%}{%- endif -%}
      <img src="{{ product.featured_image | image_url: width: 600 }}" srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w" sizes="(min-width: 1100px) 360px, (min-width: 700px) 45vw, 92vw" alt="{{ card_alt | escape }}" loading="lazy" width="600" height="450">
    {% else %}
      <div class="product-card-placeholder">
        {% render 'icon-shopping-bag' %}
      </div>
    {% endif %}
    {%- if roast_label != '' -%}
      <span class="roast-chip"><span class="roast-chip__beans" aria-hidden="true">{%- for i in (1..5) -%}<i{% if i <= rp.lv %} class="on"{% endif %}></i>{%- endfor -%}</span>{{ roast_label }}</span>
    {%- endif -%}
  </a>

  <div class="product-card-content">
    <a href="{{ product.url }}" class="product-card-title no-underline">
      <h3>{{ product.title }}</h3>
    </a>
    {%- assign card_rating = product.metafields.reviews.rating.value.rating | round: 1 -%}
    {%- if card_rating and card_rating > 0 -%}
      {%- assign card_count = product.metafields.reviews.rating_count.value | default: 0 -%}
      <div class="product-card-rating" aria-label="Rated {{ card_rating }} out of 5 from {{ card_count }} reviews">
        {% render 'icon-star' %} <span>{{ card_rating }}</span>{% if card_count > 0 %} <span class="product-card-rating-count">({{ card_count }})</span>{% endif %}
      </div>
    {%- endif -%}
    {%- comment -%} The first paragraph of each description is the roast and tasting-notes line. Show it on its own line so it never runs into the description. {%- endcomment -%}
    {%- assign desc_parts = product.description | split: '</p>' -%}
    {%- if desc_parts.size > 1 -%}
      {%- assign card_notes = desc_parts[0] | strip_html | strip -%}
      {%- assign card_body = desc_parts[1] | strip_html | strip -%}
      <p class="product-card-notes" style="font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-d); margin: 0 0 6px;">{{ card_notes }}</p>
      <p class="product-card-desc">{{ card_body | truncatewords: 22 }}</p>
    {%- else -%}
      <p class="product-card-desc">{{ product.description | strip_html | truncatewords: 25 }}</p>
    {%- endif -%}

    <div class="product-card-price">
      <div class="product-card-price-amount" data-product-card-price>{{ product.price | money }}</div>
      {%- if product.type == 'Coffee' -%}{%- unless product.variants.first.title contains '2 x' -%}<div class="product-card-price-label">per bag</div>{%- endunless -%}{%- endif -%}
    </div>

    {%- if product.type == 'Coffee' -%}<p class="product-card-ship" style="margin:-4px 0 12px;font-size:12.5px;color:var(--mute);">$4.50 shipping on 1 bag &middot; free on 2+</p>{%- endif -%}{%- assign gb_tag = settings.gb_picker_tag | default: 'gift-basket' -%}{%- if product.tags contains gb_tag -%}{% render 'gift-basket-discount', product: product %}<a class="btn btn-gold product-card-submit" href="{{ product.url }}" style="margin-top:12px">Choose your blends</a>{%- else -%}{% form 'product', product, class: 'product-card-form' %}
      {% render 'variant-json', product: product %}
      {% if product.variants.size > 1 %}
        <div class="product-card-options">
          {% for option in product.options_with_values %}
            <div class="product-card-option">
              <label for="option-{{ section.id }}-{{ product.id }}-{{ forloop.index }}">{{ option.name }}</label>
              <select
                id="option-{{ section.id }}-{{ product.id }}-{{ forloop.index }}"
                data-option-index="{{ forloop.index0 }}"
                data-option-select
              >
                {% for value in option.values %}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
      <input type="hidden" name="quantity" value="1">

      <button
        type="submit"
        class="btn btn-gold product-card-submit"
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
      >
        {% if product.selected_or_first_available_variant.available %}
          {% render 'icon-shopping-bag' %}
          Add to cart
        {% else %}
          Sold out
        {% endif %}
      </button>
    {% endform %}{%- endif -%}
  </div>
</article>
