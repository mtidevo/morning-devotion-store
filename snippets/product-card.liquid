{% comment %} Product card snippet for pricing grid {% endcomment %}
<article class="product-card{% if popular %} popular{% endif %}">
  {% if popular %}
    <div class="popular-badge">Most chosen</div>
  {% endif %}

  <a href="{{ product.url }}" class="product-card-image" aria-label="{{ product.title | escape }}">
    {% if product.featured_image != blank %}
      {%- assign card_alt = product.featured_image.alt -%}
      {%- if card_alt == blank or card_alt == 'Product Image' -%}{%- assign card_alt = product.title | append: ' coffee, 12 oz carton' -%}{%- endif -%}
      <img src="{{ product.featured_image | image_url: width: 600 }}" srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w" sizes="(min-width: 1100px) 360px, (min-width: 700px) 45vw, 92vw" alt="{{ card_alt | escape }}" loading="lazy" width="600" height="450">
    {% else %}
      <div class="product-card-placeholder">
        {% render 'icon-shopping-bag' %}
      </div>
    {% endif %}
  </a>

  <div class="product-card-content">
    <a href="{{ product.url }}" class="product-card-title no-underline">
      <h3>{{ product.title }}</h3>
    </a>
    {%- assign card_rating = product.metafields.reviews.rating.value.rating | round: 1 -%}
    {%- if card_rating and card_rating > 0 -%}
      {%- assign card_count = product.metafields.reviews.rating_count.value | default: 0 -%}
      <div class="product-card-rating" aria-label="Rated {{ card_rating }} out of 5 from {{ card_count }} reviews">
        {% render 'icon-star' %} <span>{{ card_rating }}</span>{% if card_count > 0 %} <span class="product-card-rating-count">({{ card_count }})</span>{% endif %}
      </div>
    {%- endif -%}
    <p class="product-card-desc">{{ product.description | strip_html | truncatewords: 25 }}</p>

    <div class="product-card-price">
      <div class="product-card-price-amount" data-product-card-price>{{ product.price | money }}</div>
      {%- if product.type == 'Coffee' -%}{%- unless product.variants.first.title contains '2 x' -%}<div class="product-card-price-label">per bag</div>{%- endunless -%}{%- endif -%}
    </div>

    {% form 'product', product, class: 'product-card-form' %}
      {% render 'variant-json', product: product %}
      {% if product.variants.size > 1 %}
        <div class="product-card-options">
          {% for option in product.options_with_values %}
            <div class="product-card-option">
              <label for="option-{{ section.id }}-{{ product.id }}-{{ forloop.index }}">{{ option.name }}</label>
              <select
                id="option-{{ section.id }}-{{ product.id }}-{{ forloop.index }}"
                data-option-index="{{ forloop.index0 }}"
                data-option-select
              >
                {% for value in option.values %}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
      <input type="hidden" name="quantity" value="1">

      <button
        type="submit"
        class="btn btn-gold product-card-submit"
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
      >
        {% if product.selected_or_first_available_variant.available %}
          {% render 'icon-shopping-bag' %}
          Add to cart
        {% else %}
          Sold out
        {% endif %}
      </button>
    {% endform %}
  </div>
</article>
