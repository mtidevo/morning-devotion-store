{% comment %}
  Cart add-on: "Make it a gift" card for the One Blend basket.
  Rendered once in the cart drawer and once on the cart page: {% render 'gift-basket-cart-addon' %}
  Settings live in Theme settings > Christmas gift baskets.
  Shows when the cart has coffee and no gift basket. Hidden after the end date unless the basket is still in stock,
  and always hidden when it can't be bought. Adds the basket with the default blend as a line item property.
{% endcomment %}
{%- liquid
  assign gb = settings.gb_addon_product
  assign show = settings.gb_addon_enabled
  if gb == blank or gb.available == false
    assign show = false
  endif
  if show and settings.gb_addon_end != blank
    assign now_s = 'now' | date: '%s' | plus: 0
    assign end_s = settings.gb_addon_end | date: '%s' | plus: 0
    if now_s > end_s and gb.available == false
      assign show = false
    endif
  endif
  assign basket_tag = settings.gb_picker_tag | default: 'gift-basket'
  assign has_coffee = false
  assign has_basket = false
  for item in cart.items
    if item.product.tags contains basket_tag
      assign has_basket = true
    elsif item.product.type == 'Coffee'
      assign has_coffee = true
    endif
  endfor
  unless has_coffee
    assign show = false
  endunless
  if has_basket
    assign show = false
  endif
  assign blend = settings.gb_default_first.title | default: 'Emmanuel'
  assign v = gb.selected_or_first_available_variant
-%}
{%- if show -%}
<div class="gba" data-gba>
  <style>
    .gba { display:grid; grid-template-columns:56px 1fr auto; gap:12px; align-items:center; margin:12px 0; padding:12px; border:1px solid rgba(51,69,56,.22); border-radius:14px; background:#F8F6F0; color:#231d15; font-family:var(--sans,'Jost',sans-serif); }
    .gba img { width:56px; height:56px; border-radius:10px; object-fit:cover; background:#ece6d9; }
    .gba__title { font-size:14px; line-height:1.35; margin:0; color:#231d15; }
    .gba__meta { font-size:12.5px; color:#5f5649; margin:2px 0 0; line-height:1.4; }
    .gba__meta a { color:#334538; text-underline-offset:3px; }
    .gba__meta a:focus-visible, .gba__add:focus-visible { outline:2px solid #334538; outline-offset:2px; border-radius:6px; }
    .gba__add { min-width:64px; min-height:40px; padding:8px 16px; border:0; border-radius:999px; background:#334538; color:#F8F6F0; font:inherit; font-size:12px; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; }
    .gba__add:hover { background:#26352a; }
    .gba__add[aria-busy="true"] { opacity:.6; cursor:progress; }
    .gba__err { grid-column:1 / -1; margin:0; font-size:12.5px; color:#7a2b2b; }
    .gba__err:empty { display:none; }
  </style>
  {%- if gb.featured_image -%}{{ gb.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}{%- else -%}<span></span>{%- endif -%}
  <div>
    <p class="gba__title">{{ settings.gb_addon_text }}</p>
    {% render 'gift-basket-discount', product: gb %}
    <p class="gba__meta">
      {{ v.price | money }}{% if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif %}
      · {{ settings.gb_blend_label_one | default: 'Blend' }}: {{ blend }} · <a href="{{ gb.url }}">{{ settings.gb_addon_change_label }}</a>
    </p>
  </div>
  <button type="button" class="gba__add" data-gba-add data-variant="{{ v.id }}" data-prop="{{ settings.gb_blend_label_one | default: 'Blend' | escape }}" data-blend="{{ blend | escape }}" aria-label="{{ settings.gb_addon_button | escape }}: {{ gb.title | escape }}, {{ blend | escape }}">{{ settings.gb_addon_button }}</button>
  <p class="gba__err" role="alert" data-gba-err></p>
</div>
{%- endif -%}
<script>
  (function () {
    if (window.__femGiftAddon) return;
    window.__femGiftAddon = true;
    function refreshCartPage(fromEl) {
      var sec = fromEl.closest('.shopify-section');
      if (!sec || !sec.id) { window.location.reload(); return Promise.resolve(); }
      var id = sec.id.replace('shopify-section-', '');
      return fetch(window.location.pathname + '?sections=' + encodeURIComponent(id), { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data[id]) { window.location.reload(); return; }
          var doc = new DOMParser().parseFromString(data[id], 'text/html');
          var fresh = doc.getElementById(sec.id) || doc.body.firstElementChild;
          if (fresh) sec.innerHTML = fresh.innerHTML;
        });
    }
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-gba-add]');
      if (!btn) return;
      e.preventDefault();
      var card = btn.closest('[data-gba]');
      var err = card && card.querySelector('[data-gba-err]');
      if (err) err.textContent = '';
      var props = {}; props[btn.getAttribute('data-prop')] = btn.getAttribute('data-blend');
      btn.setAttribute('aria-busy', 'true'); btn.disabled = true;
      var inDrawer = !!btn.closest('[data-cd]');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(btn.getAttribute('data-variant')), quantity: 1, properties: props }] })
      })
        .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.description || j.message || 'Could not add the basket.'); }); })
        .then(function () {
          var jobs = [];
          if (window.FEMCart && window.FEMCart.refresh) jobs.push(window.FEMCart.refresh());
          if (!inDrawer) jobs.push(refreshCartPage(btn));
          return Promise.all(jobs);
        })
        .catch(function (x) {
          btn.removeAttribute('aria-busy'); btn.disabled = false;
          if (err) err.textContent = x.message;
        });
    });
  })();
</script>
